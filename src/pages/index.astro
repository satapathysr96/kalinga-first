---
import Layout from '../layouts/Layout.astro';
import BreakingTicker from '../components/BreakingTicker.astro';
import NewsCard from '../components/NewsCard.astro';
import {
  getAllArticles,
  getBreakingArticles,
  getHeroArticle,
} from '../lib/contentful.js';

// All data-fetching runs at build time. Each helper returns safe fallbacks,
// so these will never throw even if Contentful is unreachable.
const [allArticles, breaking, hero] = await Promise.all([
  getAllArticles(),
  getBreakingArticles(),
  getHeroArticle(),
]);

// Side-feed: the 3 most recent stories that are not the hero.
const sideFeed = allArticles.filter((a) => a.slug !== hero?.slug).slice(0, 3);

// Main grid: the next batch of stories (excludes hero + side feed).
const usedSlugs = new Set([hero?.slug, ...sideFeed.map((a) => a.slug)]);
const gridArticles = allArticles.filter((a) => !usedSlugs.has(a.slug)).slice(0, 6);

const heroCategorySlug = hero ? String(hero.category).toLowerCase() : 'local';
const heroDate = hero?.publishedDate
  ? new Date(hero.publishedDate).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : '';
---

<Layout activePath="/">
  <BreakingTicker articles={breaking} />

  <main class="container">
    {
      hero ? (
        <section class="hero-grid">
          <article class="main-feature">
            <a href={`/articles/${hero.slug}`} class="feature-img">
              {hero.featuredImage?.url ? (
                <img src={hero.featuredImage.url} alt={hero.featuredImage.alt || hero.title} />
              ) : (
                <div class="img-placeholder">
                  <i class="fa-regular fa-image" />
                </div>
              )}
            </a>
            <div class="feature-content">
              <span class={`meta-tag cat-${heroCategorySlug}`}>{hero.category}</span>
              <h2>
                <a href={`/articles/${hero.slug}`}>{hero.title}</a>
              </h2>
              <p class="feature-summary">{hero.summary}</p>
              <div class="card-meta">
                {heroDate && `${heroDate} • `}
                {hero.readTime} min read
              </div>
            </div>
          </article>

          <aside class="side-feed">
            <h3>Latest Updates</h3>
            {sideFeed.length > 0 ? (
              sideFeed.map((a) => (
                <a href={`/articles/${a.slug}`} class="feed-card">
                  <span class="feed-cat">{a.category}</span>
                  <h4>{a.title}</h4>
                </a>
              ))
            ) : (
              <p class="empty-note">No additional stories yet.</p>
            )}
          </aside>
        </section>
      ) : (
        <section class="empty-state">
          <i class="fa-regular fa-newspaper" />
          <h2>No stories available right now</h2>
          <p>
            Connect Contentful (see <code>.env.template</code>) to publish live news, or
            check back shortly.
          </p>
        </section>
      )
    }

    {
      gridArticles.length > 0 && (
        <section>
          <h2 class="section-title">Top Stories</h2>
          <div class="news-grid">
            {gridArticles.map((a) => (
              <NewsCard article={a} />
            ))}
          </div>
        </section>
      )
    }

    <div class="see-all-wrap">
      <a href="/articles" class="see-all-btn">
        View All Articles <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>
  </main>
</Layout>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 30px;
    margin-bottom: 50px;
  }

  @media (max-width: 992px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }

  .main-feature {
    background: var(--bg-white);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    border-bottom: 4px solid var(--primary);
  }

  .feature-img {
    display: block;
    height: 400px;
    background: #cbd5e1;
    overflow: hidden;
  }

  .feature-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .main-feature:hover .feature-img img {
    transform: scale(1.04);
  }

  .img-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--primary) 0%, #1e3a5f 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.2);
    font-size: 4rem;
  }

  .feature-content {
    padding: 30px;
  }

  .feature-content h2 {
    font-family: var(--font-heading);
    font-size: 2rem;
    color: var(--primary);
    margin: 12px 0 15px;
    line-height: 1.25;
  }

  .feature-content h2 a:hover {
    color: var(--accent);
  }

  .feature-summary {
    color: var(--text-muted);
    margin-bottom: 15px;
  }

  .side-feed h3 {
    font-family: var(--font-heading);
    color: var(--primary);
    border-bottom: 2px solid var(--primary);
    padding-bottom: 10px;
    margin-bottom: 20px;
  }

  .feed-card {
    display: block;
    background: var(--bg-white);
    padding: 20px;
    border-radius: 6px;
    margin-bottom: 15px;
    border-left: 3px solid var(--accent);
    transition: var(--transition);
  }

  .feed-card:hover {
    transform: translateX(5px);
    box-shadow: var(--shadow-sm);
  }

  .feed-cat {
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }

  .feed-card h4 {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    color: var(--primary);
    margin-top: 6px;
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 30px;
  }

  .empty-note {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .empty-state {
    text-align: center;
    padding: 80px 20px;
    background: var(--bg-white);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    margin-bottom: 40px;
  }

  .empty-state i {
    font-size: 3rem;
    color: var(--border-color);
    margin-bottom: 16px;
  }

  .empty-state h2 {
    font-family: var(--font-heading);
    color: var(--primary);
    margin-bottom: 10px;
  }

  .empty-state p {
    color: var(--text-muted);
  }

  .see-all-wrap {
    text-align: center;
    margin-top: 45px;
  }

  .see-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--primary);
    color: #fff;
    padding: 14px 30px;
    border-radius: 6px;
    font-weight: 600;
    transition: var(--transition);
  }

  .see-all-btn:hover {
    background: var(--accent);
    gap: 14px;
  }
</style>
