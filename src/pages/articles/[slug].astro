---
import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/NewsCard.astro';
import {
  getAllArticles,
  getArticleBySlug,
  getRelatedArticles,
} from '../../lib/contentful.js';
import { documentToHtmlString } from '@contentful/rich-text-html-renderer';
import { BLOCKS, INLINES } from '@contentful/rich-text-types';

/**
 * Build-time route generation: one page per article slug.
 * Falls back to bundled sample slugs when Contentful is unconfigured.
 */
export async function getStaticPaths() {
  const articles = await getAllArticles();
  return articles
    .filter((a) => a.slug)
    .map((a) => ({
      params: { slug: a.slug },
      props: { article: a },
    }));
}

const { slug } = Astro.params;
// Prefer the prop passed from getStaticPaths; re-fetch as a safety net.
let article = Astro.props.article ?? (await getArticleBySlug(slug));

if (!article) {
  return Astro.redirect('/articles');
}

const related = await getRelatedArticles(article, 3);

const categorySlug = String(article.category).toLowerCase();
const dateLabel = article.publishedDate
  ? new Date(article.publishedDate).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : '';

// ---- Render Contentful Rich Text safely into styled HTML ----
// Custom renderers keep asset/hyperlink handling predictable.
let bodyHtml = '';
try {
  if (article.content && typeof article.content === 'object') {
    bodyHtml = documentToHtmlString(article.content, {
      renderNode: {
        [INLINES.HYPERLINK]: (node, next) =>
          `<a href="${node.data.uri}" target="_blank" rel="noopener noreferrer">${next(
            node.content
          )}</a>`,
        [BLOCKS.EMBEDDED_ASSET]: (node) => {
          const file = node?.data?.target?.fields?.file;
          const title = node?.data?.target?.fields?.title ?? '';
          if (!file?.url) return '';
          const url = file.url.startsWith('//') ? `https:${file.url}` : file.url;
          return `<figure><img src="${url}" alt="${title}" loading="lazy" /><figcaption>${title}</figcaption></figure>`;
        },
      },
    });
  } else if (typeof article.content === 'string') {
    // Defensive: some setups may store plain text.
    bodyHtml = `<p>${article.content}</p>`;
  }
} catch (err) {
  console.error('[Article] Rich text render failed:', err?.message ?? err);
  bodyHtml = '';
}

if (!bodyHtml) {
  bodyHtml = `<p>${article.summary || 'Full story content is being prepared. Please check back soon.'}</p>`;
}
---

<Layout
  activePath="/articles"
  title={article.title}
  description={article.summary}
>
  <main class="container article-page">
    <a href="/articles" class="back-link">
      <i class="fa-solid fa-arrow-left"></i> Back to Articles
    </a>

    <article class="article">
      <header class="article-header">
        <span class={`meta-tag cat-${categorySlug}`}>{article.category}</span>
        <h1>{article.title}</h1>
        {article.summary && <p class="lede">{article.summary}</p>}
        <div class="byline">
          <span><i class="fa-solid fa-user-pen"></i> Staff Reporter</span>
          {dateLabel && <span><i class="fa-regular fa-calendar"></i> {dateLabel}</span>}
          <span><i class="fa-regular fa-clock"></i> {article.readTime} min read</span>
        </div>
      </header>

      {
        article.featuredImage?.url && (
          <figure class="hero-image">
            <img
              src={article.featuredImage.url}
              alt={article.featuredImage.alt || article.title}
            />
          </figure>
        )
      }

      <div class="article-body" set:html={bodyHtml} />
    </article>

    {
      related.length > 0 && (
        <section class="related">
          <h2 class="section-title">Related Stories</h2>
          <div class="news-grid">
            {related.map((a) => (
              <NewsCard article={a} />
            ))}
          </div>
        </section>
      )
    }
  </main>
</Layout>

<style>
  .article-page {
    max-width: 820px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 25px;
    transition: var(--transition);
  }

  .back-link:hover {
    color: var(--accent);
  }

  .article-header h1 {
    font-family: var(--font-heading);
    font-size: 2.4rem;
    color: var(--primary);
    line-height: 1.2;
    margin: 14px 0 12px;
  }

  .lede {
    font-size: 1.15rem;
    color: var(--text-muted);
    margin-bottom: 18px;
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    color: var(--text-muted);
    font-size: 0.85rem;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border-color);
  }

  .byline i {
    color: var(--accent);
    margin-right: 5px;
  }

  .hero-image {
    margin: 28px 0;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .hero-image img {
    width: 100%;
    max-height: 460px;
    object-fit: cover;
  }

  /* Rich text body typography */
  .article-body {
    font-size: 1.08rem;
    line-height: 1.85;
    color: var(--text-dark);
  }

  .article-body :global(p) {
    margin-bottom: 1.3em;
  }

  .article-body :global(h2),
  .article-body :global(h3) {
    font-family: var(--font-heading);
    color: var(--primary);
    margin: 1.6em 0 0.6em;
    line-height: 1.3;
  }

  .article-body :global(h2) {
    font-size: 1.6rem;
  }

  .article-body :global(h3) {
    font-size: 1.3rem;
  }

  .article-body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 1.3em 1.4em;
  }

  .article-body :global(ul) {
    list-style: disc;
  }

  .article-body :global(ol) {
    list-style: decimal;
  }

  .article-body :global(li) {
    margin-bottom: 0.5em;
  }

  .article-body :global(blockquote) {
    border-left: 4px solid var(--accent);
    background: var(--bg-white);
    padding: 16px 22px;
    margin: 1.5em 0;
    font-style: italic;
    color: var(--primary);
    border-radius: 0 6px 6px 0;
  }

  .article-body :global(figure) {
    margin: 1.8em 0;
  }

  .article-body :global(figure img) {
    border-radius: var(--radius);
    width: 100%;
  }

  .article-body :global(figcaption) {
    font-size: 0.82rem;
    color: var(--text-muted);
    text-align: center;
    margin-top: 8px;
  }

  .related {
    margin-top: 60px;
    padding-top: 20px;
    border-top: 2px solid var(--border-color);
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 24px;
  }

  @media (max-width: 600px) {
    .article-header h1 {
      font-size: 1.8rem;
    }
  }
</style>
