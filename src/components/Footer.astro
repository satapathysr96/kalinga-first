---
/** Global site footer with brand line, quick links, and socials. */
const year = new Date().getFullYear();
---

<footer>
  <div class="container footer-grid">
    <div class="footer-brand">
      <p class="brand-name">Kalinga First 24*7 News</p>
      <p class="brand-tag">First in News. First in Trust.</p>
      <p class="brand-copy">© {year} Kalinga First 24*7 News. All rights reserved.</p>
    </div>

    <div class="footer-links">
      <h4>Explore</h4>
      <a href="/">Home</a>
      <a href="/articles">Articles</a>
      <a href="/about">About Us</a>
      <a href="/contact">Contact Us</a>
    </div>

    <div class="footer-contact">
      <h4>Newsroom</h4>
      <p><i class="fa-solid fa-envelope"></i> contact@kalingafirst.com</p>
      <p><i class="fa-solid fa-location-dot"></i> Bhubaneswar, Odisha, 751001</p>
      <div class="social-icons">
        <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook"></i></a>
        <a href="#" aria-label="X (Twitter)"><i class="fa-brands fa-x-twitter"></i></a>
        <a href="#" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--primary);
    color: #ffffff;
    padding: 45px 0 30px;
    border-top: 5px solid var(--accent);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1.5fr;
    gap: 40px;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.2rem;
  }

  .brand-tag {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9rem;
    margin: 4px 0 14px;
  }

  .brand-copy {
    font-size: 0.8rem;
    color: #cbd5e1;
  }

  .footer-links h4,
  .footer-contact h4 {
    font-family: var(--font-heading);
    margin-bottom: 12px;
    font-size: 1.05rem;
  }

  .footer-links a {
    display: block;
    color: #cbd5e1;
    font-size: 0.9rem;
    padding: 4px 0;
    transition: var(--transition);
  }

  .footer-links a:hover {
    color: #ffffff;
    padding-left: 4px;
  }

  .footer-contact p {
    font-size: 0.9rem;
    color: #cbd5e1;
    margin-bottom: 8px;
  }

  .footer-contact i {
    color: var(--accent);
    margin-right: 8px;
  }

  .social-icons {
    margin-top: 14px;
  }

  .social-icons a {
    font-size: 1.3rem;
    margin-right: 16px;
    transition: var(--transition);
  }

  .social-icons a:hover {
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
</style>
